{
  "name": "hexa-ai-benchmark-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.js --host",
    "dev:blender": "HEXA_SITE=blender vite --config web/vite.config.js --host",
    "build:web": "npm run build:web:todo && npm run build:web:blender",
    "build:web:todo": "HEXA_SITE=todo vite build --config web/vite.config.js",
    "build:web:blender": "HEXA_SITE=blender vite build --config web/vite.config.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.10"
  }
}
